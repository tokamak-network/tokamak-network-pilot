# ==============================================
# Tokamak Network Pilot — Environment Variables
# ==============================================
# Copy this file to .env and fill in the values.

# ---- LLM Provider ----
# Options: openai, anthropic
LLM_PROVIDER=openai
# Override default model (optional):
#   OpenAI models:    gpt-5.2, gpt-5-mini, gpt-5-nano, gpt-4.1, gpt-4.1-mini (default), gpt-4.1-nano
#   Anthropic models: claude-opus-4-6, claude-sonnet-4-5 (default), claude-haiku-4-5
# LLM_MODEL=

# ---- API Keys ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Embeddings (always uses OpenAI — Anthropic has no embeddings API) ----
# Options: text-embedding-3-small (1536d, default), text-embedding-3-large (3072d)
# EMBEDDING_MODEL=text-embedding-3-small

# ---- GitHub RAG Source ----
GITHUB_TOKEN=
GITHUB_ORGS=tokamak-network
# Comma-separated list of repos to index (leave empty for all org repos)
GITHUB_REPOS=

# ---- Vector Database ----
# Options: pinecone, qdrant, pgvector, chroma
VECTOR_DB_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- PostgreSQL (metadata, auth, content) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tokamak_pilot

# ---- Redis (caching, queues) ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=7d

# ---- API ----
API_PORT=4000
API_PREFIX=/api/v1

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=Tokamak Pilot
