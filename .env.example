# ==============================================
# Tokamak Network Pilot — Environment Variables
# ==============================================
# Copy this file to .env and fill in the values.

# ---- LLM Provider ----
# Options: openai, anthropic
LLM_PROVIDER=openai
# Override default model (optional):
#   OpenAI models:    gpt-5.2, gpt-5-mini, gpt-5-nano, gpt-4.1, gpt-4.1-mini (default), gpt-4.1-nano
#   Anthropic models: claude-opus-4-6, claude-sonnet-4-5 (default), claude-haiku-4-5
# LLM_MODEL=

# ---- API Keys ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Embeddings (always uses OpenAI — Anthropic has no embeddings API) ----
# Options: text-embedding-3-small (1536d, default), text-embedding-3-large (3072d)
# EMBEDDING_MODEL=text-embedding-3-small

# ---- GitHub RAG Source ----
GITHUB_TOKEN=
GITHUB_ORGS=tokamak-network
# Comma-separated list of repos to index (leave empty for all org repos)
GITHUB_REPOS=
# Auto-seed sources from GITHUB_ORGS/GITHUB_REPOS on startup (default: true)
# Set to false to disable automatic ingestion on server start
AUTO_SEED_ON_STARTUP=true
# Minimum delay (ms) between consecutive GitHub API requests to stay within rate limits
# Authenticated: 5000 req/hr → ~720ms spacing. Default 100ms is safe for normal use.
# GITHUB_REQUEST_DELAY_MS=100

# ---- Vector Database ----
# Options: pinecone, qdrant, pgvector, chroma
VECTOR_DB_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- PostgreSQL (metadata, auth, content) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tokamak_pilot

# ---- Redis (caching, queues) ----
REDIS_URL=redis://localhost:6380

# ---- Auth (Email OTP) ----
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=7d

# Resend API key for sending OTP emails (https://resend.com)
# Leave blank for dev mode — code "123456" is always accepted on localhost
RESEND_API_KEY=
# "From" domain for outbound email (must be verified in Resend)
EMAIL_FROM_DOMAIN=tokamak.network

# ---- API ----
API_PORT=4000
API_PREFIX=/api/v1
# CORS origin for the frontend (set to your Railway web URL in production)
CORS_ORIGIN=http://localhost:3000

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=Tokamak Forest

# ---- Production / Railway ----
# NODE_ENV=production          # Set automatically by Railway
# PORT=                        # Set automatically by Railway
# DATABASE_URL=                # Railway injects this from the PostgreSQL plugin
# REDIS_URL=                   # Railway injects this from the Redis plugin
# QDRANT_URL=                  # Set to your Railway Qdrant service internal URL
# CORS_ORIGIN=https://your-web-app.up.railway.app
# NEXT_PUBLIC_API_URL=https://api.tokamakforest.com/api/v1
