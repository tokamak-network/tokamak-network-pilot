{
  "name": "@tokamak-pilot/api",
  "version": "0.1.0",
  "private": true,
  "description": "Tokamak Pilot — NestJS API server (RAG, content management, SDKs)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
