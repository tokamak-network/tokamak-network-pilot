    "@nestjs/swagger": "^11.0.0",
    "@octokit/rest": "^22.0.1",
    "@qdrant/js-client-rest": "^1.16.2",
    "@tokamak-pilot/shared": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "openai": "^6.18.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^11.0.0",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
